{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-markdown-docs.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-montage.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-design-system.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "humanize-korean@im-not-ai": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    }
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:seed-design.io)",
      "Bash(curl -sL https://seed-design.io/*)",
      "Bash(pnpm --filter @rebirth/web exec npx @seed-design/cli@latest add:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)"
    ]
  },
  "enabledMcpjsonServers": [
    "seed-docs"
  ]
}
