# 값을 채워 .env.local 로 복사해 씁니다. .env.local 은 커밋하지 않습니다.

# Anthropic 비전 분석
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# 카카오 로컬 API 역지오코딩과 장소 검색. 서버 전용
KAKAO_REST_API_KEY=

# 운영 API 공유 토큰. x-admin-token 헤더로 보냄
# 비워 두면 운영 API 가 모든 요청을 거절함
ADMIN_API_TOKEN=

# 카카오맵 JS SDK. 위치 선택 지도에만 쓰며 브라우저로 나감
# 비워 두면 지도 없이 장소 검색으로만 위치를 고름
NEXT_PUBLIC_KAKAO_JS_KEY=

# 배포 도메인. OG 메타와 QR 코드 생성에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000
