# 값을 채워 .env.local 로 복사해 씁니다. .env.local 은 커밋하지 않습니다.

# Anthropic 비전 분석
ANTHROPIC_API_KEY=
# AI 초안을 실제로 부르지 않고 고정 더미를 돌려줌. 크레딧 없이 화면을 볼 때만 씀
# 1 정상 초안, not-animal 동물 없음 판정, low-quality 어두운 사진 판정, 0 이나 없으면 실제 호출
ANALYZE_MOCK=0

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# 카카오 로컬 API 역지오코딩과 장소 검색. 서버 전용
KAKAO_REST_API_KEY=

# 운영 API 공유 토큰. x-admin-token 헤더로 보냄
# 비워 두면 운영 API 가 모든 요청을 거절함
ADMIN_API_TOKEN=

# e2e 실행용 레이트리밋 완화. 로컬과 CI 에서만 true 로 둠
RATE_LIMIT_RELAXED=

# 배포 도메인. OG 메타와 QR 코드 생성에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000
